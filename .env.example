# 로컬 개발용. 복사해서 .env 로 저장하면 `npm run dev:api` 가 읽는다.
# Railway 에서는 대시보드 Variables 에 같은 이름으로 넣는다.

# Postgres 접속 주소. Railway 는 Postgres 를 추가하면 자동으로 만들어 준다.
DATABASE_URL=postgresql:///wonda_dev

# 관리자(/admin) 로그인 비밀번호. 길고 추측하기 어렵게.
ADMIN_PASSWORD=

# 로그인 쿠키 서명 키. 아래 명령으로 만든 값을 넣는다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 로컬 API 포트. vite 개발 서버가 /api 를 여기로 넘긴다.
PORT=3002

# 배포 도메인. 공유 카드(og:image)와 canonical 에 쓰인다.
SITE_URL=
